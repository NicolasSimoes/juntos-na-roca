[node name="CartaoMissao" type="CanvasLayer"]
layer = 8
script = ExtResource("1_script")
editor_description = "Cartão de missão: aparece antes de toda tarefa. Em cima, a Vovó explica POR QUÊ. Embaixo, um cartão por papel diz O QUÊ cada jogador faz e com quais teclas. Só fecha quando os DOIS apertam AÇÃO. Textos em Textos.MISSOES."

